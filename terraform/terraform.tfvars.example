aws_region   = "us-east-1"
project_name = "scalable-webapp"
alarm_email  = "4abdelrhman@gmail.com"

# Custom domain (optional). Leave both empty to deploy without owning a domain
# and reach the application through its CloudFront domain over HTTPS.
domain_name    = ""
hosted_zone_id = ""

# With a real domain managed in Route 53, set both values instead:
# domain_name    = "app.example.com"
# hosted_zone_id = "Z0123456789ABCDEFGHIJ"

# Optional overrides
# instance_type = "t3.small"
# asg_min_size  = 2
# asg_max_size  = 4

# PostgreSQL example:
# db_engine         = "postgres"
# db_engine_version = "16.4"
